FROM mcr.microsoft.com/playwright/python:v1.56.0-noble
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app/backend
COPY backend/requirements-api.txt backend/requirements-parser.txt ./
RUN python -m pip install -r requirements-api.txt
COPY backend/core.py backend/news_api.py ./
COPY backend/news_ai ./news_ai
COPY backend/news_parser ./news_parser
COPY frontend/dist /app/frontend/dist
EXPOSE 8080
CMD ["python", "-m", "news_api", "--host", "0.0.0.0", "--port", "8080"]
