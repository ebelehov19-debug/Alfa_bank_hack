FROM mcr.microsoft.com/playwright/python:v1.56.0-noble AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-parser.txt ./
RUN python -m pip install -r requirements-parser.txt

FROM base AS test
COPY requirements-test.txt pytest.ini ./
RUN python -m pip install -r requirements-test.txt
COPY core.py ./
COPY news_parser ./news_parser
COPY news_ai ./news_ai
COPY news_api.py ./
COPY tests ./tests
CMD ["python", "-m", "pytest", "-q"]

FROM base AS runtime
ENV NEWS_OUTPUT=/data
COPY news_parser ./news_parser
ENTRYPOINT ["python", "-m", "news_parser"]
CMD ["--output", "/data"]

FROM runtime AS session
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc novnc websockify \
    && rm -rf /var/lib/apt/lists/*
COPY browser-session.sh /app/browser-session.sh
ENV DISPLAY=:99
ENTRYPOINT ["bash", "/app/browser-session.sh"]
CMD ["--output", "/data/.browser-state.json"]
