# Copy to .env and add your team's key. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1
# If the primary host is unavailable, replace LLM_BASE_URL with:
# https://api.alfahack-gateway26.ru/v1
LLM_GEMMA_MODEL=google/gemma-4-26b-a4b-it
LLM_GLM_MODEL=z-ai/glm-5.3-flash

# Gemma filters by this topic, independently of company/role.
NEWS_AI_TOPIC="Экономика и бизнес: финансы, регулирование, отрасли, регионы, рынки, логистика и события, способные повлиять на компании. Исключать спорт, развлечения, частную жизнь и новости без делового значения."
NEWS_AI_BATCH_LIMIT=10
LLM_MAX_CALLS_PER_RUN=20
LLM_TIMEOUT=90
LLM_RETRIES=1
LLM_RUN_TIMEOUT=180
